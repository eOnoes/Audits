+export function candidateV3EscapedBytes(value: unknown, remaining: number): number {
+  const text = boundedV3Text(value, remaining);
+  let bytes = 0;
+  for (let i = 0; i < text.length; i++) {
+    const n = text.charCodeAt(i);
+    if (n >= 0xd800 && n <= 0xdbff) {
